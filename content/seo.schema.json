{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-step-guide.com/schemas/seo.schema.json",
  "title": "Crypto Step Guide page SEO metadata",
  "type": "object",
  "required": [
    "schema_version",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": [
        "content_title",
        "title",
        "description"
      ],
      "properties": {
        "content_title": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
